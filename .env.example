# ============================================================
# 크롤링 API 키
# ============================================================

# 잡알리오 (재정경제부 공공기관 채용정보) OpenAPI 키
# data.go.kr 활용신청 후 발급, 자동승인. 일일 1,000회.
ALIO_API_KEY=your_key_here


# ============================================================
# LLM API 키 (매핑 단계 자동화용)
#  - mapping/job_decision.py  --llm   : 미매핑 공고 분류
#  - 향후: mapping/map_courses.py     : 과목 → 역량 weight (course_competency.csv)
#  - 향후: mapping/map_postings.py    : 직무 → 역량 required_level (job_competency.csv)
# ============================================================

# OpenAI — 분류·추출·랭킹 같은 단순 작업엔 nano (2026-03 출시, $0.20/$1.25 per 1M tok)
# mini가 필요한 작업이면 OPENAI_MODEL=gpt-5.4-mini 로 교체.
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-5.4-nano
